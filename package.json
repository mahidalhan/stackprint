{
  "name": "stackprint",
  "version": "0.3.2",
  "description": "Generate, review, and deliberately publish a builder profile from installed tool metadata.",
  "type": "module",
  "bin": {
    "stackprint": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/catalog.js && node --check src/discovery.js && node --check src/profile.js && node --check src/publish.js && node --check src/render.js",
    "atlas:candidates": "node scripts/atlas/collect-candidates.mjs",
    "atlas:evidence": "node scripts/atlas/collect-evidence.mjs",
    "atlas:evidence-search": "node scripts/atlas/collect-search-evidence.mjs",
    "atlas:build": "node scripts/atlas/build-profiles.mjs",
    "atlas:check": "node scripts/atlas/check-profiles.mjs",
    "atlas:status": "node scripts/atlas/status.mjs",
    "atlas:verify": "node scripts/atlas/check-profiles.mjs --min 1000",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahidalhan/stackprint.git"
  },
  "bugs": {
    "url": "https://github.com/mahidalhan/stackprint/issues"
  },
  "homepage": "https://stackprint-builder.vercel.app",
  "keywords": [
    "builder-profile",
    "cli",
    "developer-tools",
    "local-first",
    "privacy",
    "stack",
    "tooling"
  ],
  "author": "Mahid Alhan",
  "license": "MIT"
}
